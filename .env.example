# --- Network ---
# Testnets: hederaTestnet (free, no API key), arbitrumSepolia (Dwellir), localhost
# Mainnets: hederaMainnet, arbitrumOne (Dwellir) — real funds
NETWORK=hederaTestnet
# Dwellir API key (https://dashboard.dwellir.com), only for the Arbitrum networks
DWELLIR_API_KEY=
# Optional: override the network's RPC endpoint (its chain ID must still match
# NETWORK), e.g. a commercial Hedera relay in production, or
# http://host.docker.internal:8545 for NETWORK=localhost from docker compose
RPC_URL=

# --- Registry ---
# Printed by `python -m app.cli deploy`
REGISTRY_ADDRESS=

# --- API ---
# Bearer token required for writes, at least 32 chars. Generate with: openssl rand -hex 32
API_TOKEN=
# Wallet that signs passport writes; must be a minter on the registry and hold gas funds.
# Defaults to DEPLOYER_PRIVATE_KEY (fine on a testnet; use a separate wallet in production).
MINTER_PRIVATE_KEY=
# Blocks to wait for before a write returns
CONFIRMATIONS=1
# Host port docker compose publishes the API on (bound to 127.0.0.1)
PORT=8080

# --- CLI only (python -m app.cli) — keep these off the production server ---
# Deploys the registry (0x-prefixed private key)
DEPLOYER_PRIVATE_KEY=
# Adds/removes minters. Defaults to DEPLOYER_PRIVATE_KEY.
ADMIN_PRIVATE_KEY=
