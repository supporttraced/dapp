# Dwellir API key from https://dashboard.dwellir.com (used for Base Sepolia and Base mainnet)
DWELLIR_API_KEY=
# Private key of the deployer / backend minter wallet (0x-prefixed). Testnet-only wallet!
DEPLOYER_PRIVATE_KEY=
# Deployed DppAnchorRegistry address (printed by the deploy step, also in
# ignition/deployments/chain-<id>/deployed_addresses.json). Required by the API.
REGISTRY_ADDRESS=

# --- DPP API (backend/, `docker compose up`) ---
# baseSepolia or baseMainnet
NETWORK=baseSepolia
# Bearer token required by POST /dpps/{kind}. Generate with: openssl rand -hex 32
API_TOKEN=
# Wallet that signs mint transactions; must hold MINTER_ROLE. Defaults to DEPLOYER_PRIVATE_KEY.
MINTER_PRIVATE_KEY=
# Host port docker compose publishes the API on
PORT=8080
# Blocks to wait for before a mint returns
CONFIRMATIONS=1
# Optional: bypass Dwellir, e.g. http://127.0.0.1:8545 for `npm run node`
# (http://host.docker.internal:8545 from docker compose)
RPC_URL=
